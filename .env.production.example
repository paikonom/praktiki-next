APP_NAME="Πρακτική Άσκηση ΕΚΠΑ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.uoa.gr
APP_PORT=8080

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=praktiki
DB_USERNAME=praktiki
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
PRAKTIKI_PRIVATE_STORAGE_PATH=/var/www/html/storage/app/private

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

OPS_APOGRAFIKA_ENABLED=false
OPS_APOGRAFIKA_ENDPOINT=
OPS_APOGRAFIKA_USERNAME=
OPS_APOGRAFIKA_PASSWORD=
OPS_APOGRAFIKA_TIMEOUT=30
